    "Periodically run a full discharge and recharge cycle to maintain accurate battery capacity readings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie regelmäßig einen vollständigen Entlade- und Ladezyklus durch, um genaue Messwerte der Batteriekapazität zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecute periódicamente un ciclo completo de descarga y recarga para mantener lecturas precisas de la capacidad de la batería."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
