    "Approve Stasis in System Settings → Login Items to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigen Sie Stasis in Systemeinstellungen → Anmeldeobjekte, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba Stasis en Ajustes del Sistema → Ítems de inicio de sesión para continuar."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba Stasis en Configuración del Sistema → Elementos de inicio de sesión para continuar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 → ログイン項目で Stasis を承認して続行します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置 → 登录项”中允许 Stasis 以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定 → 登入項目」中允許 Stasis 以繼續。"
          }
        }
      }
    },
