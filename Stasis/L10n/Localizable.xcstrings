    "Automatically resume charging when the battery drops below the threshold relative to your charge limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladevorgang automatisch fortsetzen, wenn die Batterie unter den Schwellenwert relativ zum Ladelimit fällt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanudar la carga automáticamente cuando la batería caiga por debajo del umbral relativo a su límite de carga."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanudar la carga automáticamente cuando la batería caiga por debajo del umbral relativo a tu límite de carga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーが充電上限に対するしきい値を下回ったときに充電を自動的に再開します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当电量低于充电上限对应阈值时，自动恢复充电。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當電量低於充電上限對應閾值時，自動恢復充電。"
          }
        }
      }
    },
