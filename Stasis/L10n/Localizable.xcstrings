          }
        }
      }
    },
    "All preferences will be restored to their defaults and Stasis will restart immediately.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen werden auf die Standardwerte zurückgesetzt und Stasis wird sofort neu gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las preferencias se restaurarán a sus valores predeterminados y Stasis se reiniciará inmediatamente."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las preferencias se restaurarán a sus valores predeterminados y Stasis se reiniciará inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les préférences seront restaurées par défaut et Stasis redémarrera immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le preferenze verranno ripristinate ai valori predefiniti e Stasis si riavvierà immediatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定がデフォルトに戻り、Stasisはすぐに再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기본 설정이 기본값으로 복원되고 Stasis가 즉시 다시 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle voorkeuren worden hersteld naar de standaardinstellingen en Stasis wordt onmiddellijk opnieuw opgestart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as preferências serão restauradas para os padrões e o Stasis será reiniciado imediatamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as definições serão repostas para os valores predefinidos e o Stasis será reiniciado imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки будут сброшены до значений по умолчанию, и Stasis немедленно перезапустится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky predvoľby budú obnovené na predvolené hodnoty a Stasis sa okamžite reštartuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse nastavitve bodo ponastavljene na privzete vrednosti in Stasis se bo takoj znova zagnal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm tercihler varsayılanlara geri yüklenecek ve Stasis hemen yeniden başlatılacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả tùy chọn sẽ được khôi phục về mặc định và Stasis sẽ khởi động lại ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有偏好设置将恢复为默认值，Stasis 随后会立即重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有偏好設定將恢復為預設值，Stasis 將立即重新啟動。"
          }
        }
      }
    },
