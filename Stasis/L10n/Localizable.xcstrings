    "Prevent your Mac from sleeping while charging towards the charge limit. Sleep is re-enabled once the limit is reached or the adapter is disconnected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindern Sie, dass Ihr Mac in den Ruhezustand wechselt, während er bis zum Ladelimit aufgeladen wird. Der Ruhezustand wird wieder aktiviert, sobald das Limit erreicht oder das Netzteil getrennt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitar que tu Mac entre en reposo mientras se carga hasta el límite de carga. El reposo se vuelve a activar una vez que se alcanza el límite o se desconecta el adaptador."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que tu Mac entre en reposo mientras se carga hasta el límite de carga. El reposo se vuelve a activar una vez que se alcanza el límite o se desconecta el adaptador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電上限まで充電している間、Macがスリープするのを防ぎます。上限に達するか、アダプタが切断されると、スリープは再び有効になります。"
          }
        }
      }
    },
