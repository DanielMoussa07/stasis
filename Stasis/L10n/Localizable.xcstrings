    "Pause charging when the battery temperature exceeds the threshold." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden pausieren, wenn die Batterietemperatur den Grenzwert überschreitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar la carga cuando la temperatura de la batería supere el umbral."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar la carga cuando la temperatura de la batería supere el umbral."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー温度がしきい値を超えた場合に充電を一時停止します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当电池温度超过阈值时暂停充电。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當電池溫度超過閾值時暫停充電。"
          }
        }
      }
    },
    "Periodically run a full discharge and recharge cycle to maintain accurate battery capacity readings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie regelmäßig einen vollständigen Entlade- und Ladezyklus durch, um genaue Messwerte der Batteriekapazität zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecute periódicamente un ciclo completo de descarga y recarga para mantener lecturas precisas de la capacidad de la batería."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecute periódicamente un ciclo completo de descarga y recarga para mantener lecturas precisas de la capacidad de la batería."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー容量を正確に読み取るために、定期的に完全な放電と充電のサイクルを実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期进行完整的放电和再充电循环，以保持准确的电池容量读数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期進行完整的放電與再充電循環，以保持準確的電池容量讀數。"
          }
        }
      }
    },
