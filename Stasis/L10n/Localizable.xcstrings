    "It's time for your scheduled battery calibration. This will discharge your Mac to %@ before recharging." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist Zeit für Ihre geplante Batteriekalibrierung. Dadurch wird Ihr Mac auf %@ entladen, bevor er wieder aufgeladen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hora de la calibración programada de la batería. Esto descargará su Mac al %@ antes de recargar."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hora de la calibración programada de la batería. Esto descargará su Mac al %@ antes de recargar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定されているバッテリーのキャリブレーションの時間です。これにより、再充電する前にMacが%@まで放電されます。"
          }
        }
      }
    },
