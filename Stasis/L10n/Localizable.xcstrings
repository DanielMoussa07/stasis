    "Automatically resume charging when the battery drops below the threshold relative to your charge limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladevorgang automatisch fortsetzen, wenn die Batterie unter den Schwellenwert relativ zum Ladelimit fällt."
